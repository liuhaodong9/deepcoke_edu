# DeepCoke 部署 .env — 拷贝到 deepcoke.env 并改成实际值
# 文件路径建议: /home/dbcloud/deepcoke_edu/llmcoking/deploy/deepcoke.env
# 权限: chmod 600（仅 dbcloud 读写）

# ── 鉴权 ────────────────────────────────────────────────────────────
# 公网部署务必 false，否则任何人发 "Bearer I have login" 都能通过
AUTH_LEGACY_BYPASS=false
AUTH_TOKEN_TTL_DAYS=30

# ── LLM ─────────────────────────────────────────────────────────────
# openai = vLLM/DeepSeek API 风格；ollama = Ollama 原生 /api/chat
LLM_MODE=openai
# vLLM 本地服务地址（与 deepcoke-vllm.service 的 --port 一致）
DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
DEEPSEEK_API_KEY=vllm-local
DEEPSEEK_MODEL=qwen3:8b
# vLLM 默认每次 chat 可生成的 token 数
LLM_TIMEOUT=300

# ── MySQL ───────────────────────────────────────────────────────────
# 重要：把默认密码 123456 改成强密码，并加防火墙仅 127.0.0.1 监听
DATABASE_URL=mysql+pymysql://deepcoke:STRONG_PWD_HERE@127.0.0.1:3306/chat_db?charset=utf8mb4

# ── Neo4j ───────────────────────────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=STRONG_NEO4J_PWD

# ── 数据路径 ────────────────────────────────────────────────────────
PAPERS_DIR=/home/dbcloud/deepcoke_edu/Coal blend paper
